# Salin file ini menjadi .env lalu isi sesuai kebutuhan.

# Connection string MongoDB Atlas (tugas M3), contoh:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=

# Kredensial PostgreSQL lokal (dipakai GC6 & metadata Airflow)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Service yang dijalankan di container lab: all | jupyter | airflow
SERVICES=all

# Port PostgreSQL di laptop (untuk DBeaver/pgAdmin). Dari dalam container tetap postgres:5432
POSTGRES_HOST_PORT=5433
