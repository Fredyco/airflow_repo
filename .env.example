# Salin file ini menjadi .env lalu isi. File .env tidak ikut ter-push ke GitHub.

# PostgreSQL di laptop (yang dibuka lewat pgAdmin)
PG_HOST=host.docker.internal
PG_PORT=5432
PG_DB=dwh
PG_USER=postgres
PG_PASSWORD=isi-password-postgres-kamu

# MongoDB Atlas (tugas M3)
MONGO_URI=

# Laptop RAM kecil? Ganti jadi "jupyter" supaya Airflow tidak ikut jalan
SERVICES=all
